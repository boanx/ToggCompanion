<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="@string/settings_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Togg ID Direct Login Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/tile_bg"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Togg ID Bağlantısı"
            android:textColor="@color/accent_togg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_auth_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Durum: Bağlı Değil (Simülasyon Modu)"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_togg_login"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_gradient"
            android:text="Togg ID ile Giriş Yap"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_togg_logout"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_outline"
            android:text="Togg Hesabından Çıkış Yap"
            android:textColor="@color/status_red"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_settings_abrp_shortcut"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_outline"
        android:text="ABRP Canlı Rota ve Telemetri Ayarları"
        android:textColor="@color/accent_togg"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Akıllı Saat ve Dijital Anahtar Eşleme"
        android:textColor="@color/accent_togg"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_settings_key_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Anahtar Tanımsız"
        android:textColor="@color/text_secondary" />

    <Button
        android:id="@+id/btn_settings_manage_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dijital Anahtar Ekle / Yönet" />

    <Button
        android:id="@+id/btn_settings_sync_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Saate Aktar" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="OLED Glass · Gerçek siyah"
        android:textColor="@color/accent_togg"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_app_theme"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioButton android:id="@+id/rb_theme_system" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sistem Varsayılanı" />
        <RadioButton android:id="@+id/rb_theme_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Karanlık Mod" />
        <RadioButton android:id="@+id/rb_theme_light" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aydınlık Mod" />
    </RadioGroup>

    <Button
        android:id="@+id/btn_settings_customize_cards"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/btn_outline"
        android:text="Kart Sıralaması ve Görünümü"
        android:textColor="@color/accent_togg"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_plate_label"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/et_plate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/tile_bg"
        android:padding="10dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_vin_label"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/et_vin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/tile_bg"
        android:padding="10dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Araç Sahibi ID (İsteğe bağlı - Paylaşılan araçlar için):"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/et_owner_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/tile_bg"
        android:hint="Yalnızca araç sizinle paylaşıldıysa doldurun"
        android:padding="10dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <CheckBox
        android:id="@+id/cb_demo_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/settings_demo_mode"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Optional Manual Token Field -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manuel Token (İsteğe Bağlı):"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/et_token"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/tile_bg"
        android:hint="Togg ID girişi yaptıysanız bu alanı boş bırakabilirsiniz"
        android:inputType="textMultiLine"
        android:maxLines="2"
        android:padding="8dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="11sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/tile_bg" android:orientation="vertical" android:padding="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ABRP Canlı Telemetri" android:textColor="@color/accent_togg" android:textStyle="bold" />
        <CheckBox android:id="@+id/cb_abrp_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="4 dakikada bir ABRP'ye gönder" android:textColor="@color/text_primary" />
        <CheckBox android:id="@+id/cb_abrp_route_sync" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ABRP rota değişikliğini araca aktar (~4 dk kontrol)" android:textColor="@color/text_primary" />
        <EditText android:id="@+id/et_abrp_token" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ABRP Generic Token" android:inputType="textPassword" android:singleLine="true" android:textColor="@color/text_primary" />
        <RadioGroup android:id="@+id/rg_abrp_capacity" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rb_abrp_long" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="88.5 kWh (Uzun Menzil)" />
            <RadioButton android:id="@+id/rb_abrp_standard" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="52.4 kWh (Standart Menzil)" />
        </RadioGroup>
        <Button android:id="@+id/btn_abrp_send" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/btn_gradient" android:text="Şimdi Gönder / Test Et" android:textColor="@color/white" />
        <Button android:id="@+id/btn_abrp_open" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/btn_outline" android:text="ABRP'yi Aç" android:textColor="@color/accent_togg" />
    </LinearLayout>

</LinearLayout>
</ScrollView>
