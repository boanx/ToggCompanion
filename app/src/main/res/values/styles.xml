<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ToggCompanion" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/accent_togg</item>
        <item name="android:colorControlNormal">@color/text_secondary</item>
        <item name="android:colorControlActivated">@color/text_primary</item>
        <item name="android:colorControlHighlight">#26FFFFFF</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:buttonStyle">@style/Glass.Button</item>
        <item name="android:editTextStyle">@style/Glass.Input</item>
        <item name="android:alertDialogTheme">@style/Glass.Dialog</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.ToggCompanion.Dark" parent="Theme.ToggCompanion" />
    <!-- Legacy preference aliases keep old installs on the OLED palette. -->
    <style name="Theme.ToggCompanion.Light" parent="Theme.ToggCompanion" />
    <style name="Glass.Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/glass_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Glass.Input" parent="android:Widget.Material.EditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:backgroundTint">@color/text_secondary</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Glass.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/card_bg</item>
        <item name="android:colorAccent">@color/accent_togg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:buttonStyle">@style/Glass.Button</item>
        <item name="android:editTextStyle">@style/Glass.Input</item>
        <item name="android:backgroundDimAmount">0.72</item>
    </style>
</resources>
