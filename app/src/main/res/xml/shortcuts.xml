<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Kapıları Kilitle -->
    <shortcut
        android:shortcutId="shortcut_lock"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="@string/shortcut_lock_short"
        android:shortcutLongLabel="@string/shortcut_lock_long">
        <intent
            android:action="com.togg.companion.ACTION_LOCK"
            android:targetPackage="com.togg.companion"
            android:targetClass="com.togg.companion.ui.ToggActionActivity">
            <extra android:name="action_command" android:value="lock" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <!-- 2. Kapı Kilidini Aç -->
    <shortcut
        android:shortcutId="shortcut_unlock"
        android:enabled="true"
