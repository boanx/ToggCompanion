<resources>
    <style name="Theme.ToggCompanion.Wear" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorAccent">@color/accent_togg</item>
        <item name="android:colorControlHighlight">#26FFFFFF</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:buttonStyle">@style/Glass.WearButton</item>
    </style>
    <style name="Glass.WearButton" parent="android:Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
